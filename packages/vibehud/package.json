{
  "name": "vibehud",
  "version": "0.1.0",
  "description": "A drop-in HUD for AI-agent state: your agent maintains agent-map.md, vibehud renders it as a live map + kanban and validates it against your real routes.",
  "license": "MIT",
  "homepage": "https://vibehud-one.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WhemDev/vibehud.git",
    "directory": "packages/vibehud"
  },
  "bugs": "https://github.com/WhemDev/vibehud/issues",
  "keywords": [
    "ai",
    "agent",
    "nextjs",
    "kanban",
    "visualization",
    "agent-map"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./next": "./src/next.tsx",
    "./panel": "./src/panel/VibehudPanel.tsx"
  },
  "files": [
    "src",
    "templates",
    "spec",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run"
  },
  "dependencies": {
    "yaml": "^2.5.0"
  },
  "peerDependencies": {
    "next": ">=14",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
